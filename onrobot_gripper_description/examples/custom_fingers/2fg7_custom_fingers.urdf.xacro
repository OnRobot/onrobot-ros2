<?xml version="1.0"?>
<robot name="onrobot_2fg7_custom_finger_fixture"
       xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="use_standard_fingertips" default="false"/>

  <xacro:include
    filename="$(find onrobot_2fg7)/urdf/simplemesh_onrobot_2fg7.urdf.xacro"/>

  <!-- These links deliberately belong to the consuming package, not to the
       OnRobot description. Production fingers supply their own meshes,
       collision geometry, mass properties, and contact materials. -->
  <link name="user_right_finger">
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.0000027" ixy="0" ixz="0"
               iyy="0.0000027" iyz="0" izz="0.0000003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.01 0.01 0.04"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.01 0.01 0.04"/></geometry>
    </collision>
  </link>
  <joint name="user_right_finger_joint" type="fixed">
    <parent link="right_finger_mount"/>
    <child link="user_right_finger"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="user_left_finger">
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.0000027" ixy="0" ixz="0"
               iyy="0.0000027" iyz="0" izz="0.0000003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.01 0.01 0.04"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.01 0.01 0.04"/></geometry>
    </collision>
  </link>
  <joint name="user_left_finger_joint" type="fixed">
    <parent link="left_finger_mount"/>
    <child link="user_left_finger"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
