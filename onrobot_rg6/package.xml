<package format="3">
<name>onrobot_rg6</name>
<version>0.1.0</version>
<description>
ROS 2 description, model-specific control configuration, and visualization for the OnRobot RG6 gripper.
</description>
<maintainer email="mikael.westermann@onrobot.com">Mikael Westermann</maintainer>
<license>BSD-3-Clause</license>
<buildtool_depend>ament_cmake</buildtool_depend>
<exec_depend>xacro</exec_depend>
<exec_depend>robot_state_publisher</exec_depend>
<exec_depend>controller_manager</exec_depend>
<exec_depend>joint_state_broadcaster</exec_depend>
<exec_depend>parallel_gripper_controller</exec_depend>
<exec_depend>onrobot_gripper_controllers</exec_depend>
<exec_depend>onrobot_gripper_hardware</exec_depend>
<exec_depend>tf2_ros</exec_depend>
<test_depend>ament_lint_auto</test_depend>
<test_depend>ament_lint_common</test_depend>
<export>
<build_type>ament_cmake</build_type>
</export>
</package>
