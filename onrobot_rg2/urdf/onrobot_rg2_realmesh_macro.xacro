<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ================= Xacro arguments ================= -->

      <xacro:arg name="mesh_path" default="package://onrobot_rg2/meshes"/>
      <xacro:arg name="fingertip_material" default="standard"/>
      <xacro:arg name="use_standard_fingertips" default="true"/>

      <!-- outwards or inwards -->
      <xacro:arg name="fingertip_orientation" default="inwards"/>
      <xacro:arg name="host" default="127.0.0.1"/>
      <xacro:arg name="port" default="502"/>
      <xacro:arg name="transport" default="tcp"/>
      <xacro:arg name="serial_device" default="/dev/ttyUSB0"/>
      <xacro:arg name="baud_rate" default="1000000"/>
      <xacro:arg name="rtu_parity" default="even"/>
      <xacro:arg name="slave_id" default="65"/>
      <xacro:arg name="connect_timeout_ms" default="1000"/>
      <xacro:arg name="read_timeout_ms" default="1000"/>
      <xacro:arg name="write_timeout_ms" default="1000"/>
      <xacro:arg name="backend" default="real"/>
      <xacro:arg name="isaac_joint_commands_topic" default="isaac_joint_commands"/>
      <xacro:arg name="isaac_joint_states_topic" default="isaac_joint_states"/>
      <xacro:arg name="isaac_state_timeout_ms" default="250"/>
      <xacro:arg name="safe_width_min_mm" default="0.0"/>
      <xacro:arg name="safe_width_max_mm" default="110.0"/>
      <xacro:arg name="default_force_n" default="10.0"/>
      <xacro:arg name="realtime_update_rate_hz" default="50"/>

  <xacro:macro name="onrobot_rg2_realmesh"
               params="parent:='' prefix:='' origin_xyz:='0 0 0' origin_rpy:='0 0 0' backend:='real' host:='127.0.0.1' port:='502' transport:='tcp' serial_device:='/dev/ttyUSB0' baud_rate:='1000000' rtu_parity:='even' slave_id:='65' connect_timeout_ms:='1000' read_timeout_ms:='1000' write_timeout_ms:='1000' safe_width_min_mm:='0.0' safe_width_max_mm:='110.0' default_force_n:='10.0' realtime_update_rate_hz:='50' include_ros2_control:=true">
    <!-- The hardware/CAD frame includes the linkage zero phase. The existing
         simulator articulation has its own declared coordinate range. -->
    <xacro:property name="cad_finger_upper" value="${1.22277767395 if backend == 'isaac' else asin(105.0 / 110.0) + asin(2.5 / 55.0)}"/>
    <xacro:if value="${parent != ''}">
      <joint name="${prefix}mount_joint" type="fixed">
        <parent link="${parent}"/>
        <child link="${prefix}base_link"/>
        <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
      </joint>
    </xacro:if>
      <!-- ================= Fingertip orientation ================= -->

      <xacro:if value="${'$(arg fingertip_orientation)' == 'inwards'}">
        <xacro:property name="fingertip_rpy_vis" value="${pi / 2} 0 0"/>
        <xacro:property name="fingertip_collision_xyz" value="0 0 0"/>
        <xacro:property name="fingertip_collision_rpy" value="0 0 0"/>
      </xacro:if>

      <xacro:unless value="${'$(arg fingertip_orientation)' == 'inwards'}">
        <xacro:property name="fingertip_rpy_vis" value="${pi / 2} 0 0"/>
        <xacro:property name="fingertip_collision_xyz" value="0 0 -0.007"/>
        <xacro:property name="fingertip_collision_rpy" value="${pi} 0 0"/>

      </xacro:unless>

      <!-- ================= Fingertip material ================= -->

      <xacro:if value="${'$(arg fingertip_material)' == 'standard'}">
        <xacro:property
          name="fingertip_mesh"
          value="$(arg mesh_path)/fingertip_standard"/>
      </xacro:if>

      <xacro:if value="${'$(arg fingertip_material)' == 'x'}">
        <xacro:property
          name="fingertip_mesh"
          value="$(arg mesh_path)/fingertip_x"/>
      </xacro:if>

      <xacro:if value="${'$(arg fingertip_material)' == '50_standard'}">
        <xacro:property
          name="fingertip_mesh"
          value="$(arg mesh_path)/fingertip_50_standard"/>
      </xacro:if>

      <xacro:if value="${'$(arg fingertip_material)' == '50_x'}">
        <xacro:property
          name="fingertip_mesh"
          value="$(arg mesh_path)/fingertip_50_x"/>
      </xacro:if>

      <xacro:if value="${'$(arg fingertip_material)' == '100_standard'}">
        <xacro:property
          name="fingertip_mesh"
          value="$(arg mesh_path)/fingertip_100_standard"/>
      </xacro:if>

      <xacro:if value="${'$(arg fingertip_material)' == '100_x'}">
        <xacro:property
          name="fingertip_mesh"
          value="$(arg mesh_path)/fingertip_100_x"/>
      </xacro:if>

      <!-- ================= Fingertip inertial values ================= -->

      <!-- ================= Standard and x fingertip inertia ================= -->

      <xacro:if value="${'$(arg fingertip_material)' == 'standard' or '$(arg fingertip_material)' == 'x'}">

        <xacro:property
            name="fingertip_inertial_origin_xyz"
            value="0.000874448371820824 -2.28131673908659E-09 0.000216515486391504"/>
        <xacro:property name="fingertip_mass" value="0.004350525975552"/>
        <xacro:property name="fingertip_ixx" value="1.83172636303896E-07"/>
        <xacro:property name="fingertip_ixy" value="4.94040580376697E-14"/>
        <xacro:property name="fingertip_ixz" value="3.25324283899849E-09"/>
        <xacro:property name="fingertip_iyy" value="3.17534542484979E-07"/>
        <xacro:property name="fingertip_iyz" value="-1.30290439090972E-13"/>
        <xacro:property name="fingertip_izz" value="4.52560677067772E-07"/>

      </xacro:if>

      <!-- ================= 50 mm standard and x extension inertia ================= -->

      <xacro:if value="${'$(arg fingertip_material)' == '50_standard' or '$(arg fingertip_material)' == '50_x'}">
        <xacro:property
            name="fingertip_inertial_origin_xyz"
            value="0.029538 1.5497E-08 -0.00072798"/>
        <xacro:property name="fingertip_mass" value="0.018914"/>
        <xacro:property name="fingertip_ixx" value="5.1355E-07"/>
        <xacro:property name="fingertip_ixy" value="8.9434E-12"/>
        <xacro:property name="fingertip_ixz" value="-1.2966E-08"/>
        <xacro:property name="fingertip_iyy" value="6.4087E-06"/>
        <xacro:property name="fingertip_iyz" value="-1.2067E-12"/>
        <xacro:property name="fingertip_izz" value="6.7141E-06"/>
      </xacro:if>

      <!-- ================= 100 mm standard and x extension inertia ================= -->

      <xacro:if value="${'$(arg fingertip_material)' == '100_standard' or '$(arg fingertip_material)' == '100_x'}">
          <xacro:property
            name="fingertip_inertial_origin_xyz"
            value="0.055588 3.8168E-08 -0.0010111"/>
        <xacro:property name="fingertip_mass" value="0.029865"/>
        <xacro:property name="fingertip_ixx" value="6.8081E-07"/>
        <xacro:property name="fingertip_ixy" value="6.2987E-11"/>
        <xacro:property name="fingertip_ixz" value="-5.1688E-08"/>
        <xacro:property name="fingertip_iyy" value="3.0434E-05"/>
        <xacro:property name="fingertip_iyz" value="-4.1937E-12"/>
        <xacro:property name="fingertip_izz" value="3.0817E-05"/>
      </xacro:if>

      <!-- ================= Fingertip inertial macro ================= -->

      <xacro:macro name="fingertip_inertial">
        <inertial>
          <origin
            xyz="${fingertip_inertial_origin_xyz}"
            rpy="0 0 0"/>
          <mass value="${fingertip_mass}"/>
          <inertia
            ixx="${fingertip_ixx}"
            ixy="${fingertip_ixy}"
            ixz="${fingertip_ixz}"
            iyy="${fingertip_iyy}"
            iyz="${fingertip_iyz}"
            izz="${fingertip_izz}"/>
        </inertial>
      </xacro:macro>

      <!-- ================= Shared materials ================= -->

      <material name="${prefix}body_white">
        <color rgba="1 1 1 1"/>
      </material>

      <material name="${prefix}cover_grey">
        <color
          rgba="0.25 0.25 0.25 1"/>
      </material>

      <!-- ================= Base link ================= -->

      <link name="${prefix}base_link">
        <inertial>
          <origin
            xyz="-0.00131198418656629 -0.000556731965880301 0.0176321259155524"
            rpy="0 0 0"/>
          <mass value="0.193451999968638"/>
          <inertia
            ixx="5.90803630433479E-05"
            ixy="-1.71397505073997E-08"
            ixz="3.54830418963831E-07"
            iyy="5.66555282982983E-05"
            iyz="-1.97668620237827E-07"
            izz="9.97553228051711E-05"/>
        </inertial>

        <visual>
          <origin 
            xyz="0 0 0.01384" 
            rpy="${pi} 0 ${pi}"/>
          <geometry>
            <mesh filename="$(arg mesh_path)/base_link.dae"/>
          </geometry>
        </visual>

        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="$(arg mesh_path)/base_link.STL"/>
          </geometry>
        </collision>
      </link>

      <!-- ================= Body link ================= -->

      <link name="${prefix}body_link">
        <inertial>
          <origin
            xyz="0.0361404290088884 -4.28195287969727E-05 -5.16032341026391E-05"
            rpy="0 0 0"/>
          <mass value="0.463836579743255"/>
          <inertia
            ixx="0.000112619382113841"
            ixy="-2.64039125247071E-06"
            ixz="4.11872244580003E-07"
            iyy="0.000394091945870666"
            iyz="2.70518016902612E-08"
            izz="0.000318367398754903"/>
        </inertial>

        <visual>
          <origin 
            xyz="-0.0335 0 0" 
            rpy="0 -${pi/2} 0"/>
          <geometry>
            <mesh filename="$(arg mesh_path)/body_link.dae"/>
          </geometry>
        </visual>

        <collision>
          <origin 
            xyz="0 0 0" 
            rpy="${pi} 0 0"/>
          <geometry>
            <mesh filename="$(arg mesh_path)/body_link.STL"/>
          </geometry>
        </collision>
      </link>

      <joint name="${prefix}body_joint" type="fixed">
        <origin
          xyz="0 0 0.04734"
          rpy="0 -1.5707963267949 0"/>
        <parent link="${prefix}base_link"/>
        <child link="${prefix}body_link"/>
      </joint>

      <!-- ================= Right outer proximal finger ================= -->

      <link name="${prefix}right_outer_proximal_finger_link">
        <inertial>
          <origin
            xyz="0.0549431524395903 -0.00249999999999203 0.000300000004998558"
            rpy="0 0 0"/>
          <mass value="0.000949825473476506"/>
          <inertia
            ixx="4.40551301449513E-09"
            ixy="2.09495677045624E-24"
            ixz="2.06150514093411E-24"
            iyy="4.40551301449514E-09"
            iyz="-7.79803711667657E-24"
            izz="6.16606121744734E-09"/>
        </inertial>

        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh
              filename="$(arg mesh_path)/right_outer_proximal_finger_link.STL"/>
          </geometry>
          <material name="${prefix}body_white"/>
        </visual>

        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh
              filename="$(arg mesh_path)/right_outer_proximal_finger_link.STL"/>
          </geometry>
        </collision>
      </link>

      <joint name="${prefix}finger_joint" type="revolute">
        <origin
          xyz="0.076 0 -0.01695"
          rpy="-1.5708 0 0"/>
        <parent link="${prefix}body_link"/>
        <child link="${prefix}right_outer_proximal_finger_link"/>
        <axis xyz="0 0 1"/>
        <limit
          lower="0"
          upper="${cad_finger_upper}"
          effort="2.9"
          velocity="1.753"/>
      </joint>

      <!-- ================= Right finger cover arm ================= -->

      <link name="${prefix}right_finger_cover_arm_link">
        <inertial>
          <origin
            xyz="0.00402747500688258 -0.00226575451595132 7.49786625480784E-05"
            rpy="0 0 0"/>
          <mass value="0.000275378490192093"/>
          <inertia
            ixx="2.51597692156251E-09"
            ixy="1.29593094681286E-09"
            ixz="-2.29982206511419E-14"
            iyy="4.0362519379352E-09"
            iyz="1.60986576546714E-14"
            izz="3.79488588774442E-09"/>
        </inertial>

        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh
              filename="$(arg mesh_path)/right_finger_cover_arm_link.STL"/>
          </geometry>
          <material name="${prefix}cover_grey"/>
        </visual>

        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh
              filename="$(arg mesh_path)/right_finger_cover_arm_link.STL"/>
          </geometry>
        </collision>
      </link>

      <joint name="${prefix}right_finger_cover_arm_joint" type="continuous">
        <origin
          xyz="0.0200247913038149 8.99497540430838E-05 0"
          rpy="0 0 0"/>
        <parent link="${prefix}right_outer_proximal_finger_link"/>
        <child link="${prefix}right_finger_cover_arm_link"/>
        <axis xyz="0 0 1"/>
        <mimic
          joint="${prefix}finger_joint"
          multiplier="-1"
          offset="0"/>
      </joint>

      <!-- ================= Right finger cover ================= -->

      <link name="${prefix}right_finger_cover_link">
        <inertial>
          <origin
            xyz="0.0160456742219451 -0.00117289097565787 -0.000299987923847552"
            rpy="0 0 0"/>
          <mass value="0.00238596228059738"/>
          <inertia
            ixx="4.39898697731722E-08"
            ixy="3.09574885566677E-08"
            ixz="7.78954430157744E-14"
            iyy="3.9272551878155E-07"
            iyz="-5.00980257567142E-14"
            izz="4.310453229369E-07"/>
        </inertial>

        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh
              filename="$(arg mesh_path)/right_finger_cover_link.STL"/>
          </geometry>
          <material name="${prefix}cover_grey"/>
        </visual>

        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh
              filename="$(arg mesh_path)/right_finger_cover_link.STL"/>
          </geometry>
        </collision>
      </link>

      <joint name="${prefix}right_finger_cover_joint" type="continuous">
        <origin
          xyz="0.0082499964519562 -0.0047500061623866 0"
          rpy="0 0 0"/>
        <parent link="${prefix}right_finger_cover_arm_link"/>
        <child link="${prefix}right_finger_cover_link"/>
        <axis xyz="0 0 1"/>
        <mimic
          joint="${prefix}finger_joint"
          multiplier="1"
          offset="0"/>
      </joint>

      <!-- ================= Right finger base ================= -->

      <link name="${prefix}right_finger_base_link">
        <inertial>
          <origin
            xyz="0.0190391495388182 -0.00734945969008528 -0.000300005016238398"
            rpy="0 0 0"/>
          <mass value="0.0113435416196245"/>
          <inertia
            ixx="3.81411331619534E-07"
            ixy="5.77709795343558E-07"
            ixz="1.00938104078554E-13"
            iyy="2.42489387459591E-06"
            iyz="2.12234135605753E-13"
            izz="2.56166646481153E-06"/>
        </inertial>

        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh
              filename="$(arg mesh_path)/right_finger_base_link.STL"/>
          </geometry>
          <material name="${prefix}body_white"/>
        </visual>

        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh
              filename="$(arg mesh_path)/right_finger_base_link.STL"/>
          </geometry>
        </collision>
      </link>

      <joint name="${prefix}right_finger_base_joint" type="continuous">
        <origin
          xyz="0.0549431524395901 -0.00249999999999208 0"
          rpy="0 0 0"/>
        <parent link="${prefix}right_outer_proximal_finger_link"/>
        <child link="${prefix}right_finger_base_link"/>
        <axis xyz="0 0 1"/>
        <mimic
          joint="${prefix}finger_joint"
          multiplier="-1"
          offset="0"/>
      </joint>

      <!-- ================= Right fingertip ================= -->

      <xacro:if value="$(arg use_standard_fingertips)">
      <link name="${prefix}right_finger_tip_link">
        <xacro:fingertip_inertial/>

        <visual>
          <origin
            xyz="${fingertip_collision_xyz}" 
            rpy="${fingertip_collision_rpy}"/>
          <geometry>
                <mesh filename="${fingertip_mesh}_link.dae"/>
          </geometry>
        </visual>

        <collision>
          <origin 
            xyz="${fingertip_collision_xyz}" 
            rpy="${fingertip_collision_rpy}"/>
          <geometry>
                <mesh filename="${fingertip_mesh}_link.STL"/>
          </geometry>
        </collision>
      </link>
      </xacro:if>

      <link name="${prefix}right_finger_mount"/>

      <joint name="${prefix}right_finger_mount_joint" type="fixed">
        <origin
          xyz="0.0365 -0.0145 -0.0003"
          rpy="0 0 0"/>
        <parent link="${prefix}right_finger_base_link"/>
        <child link="${prefix}right_finger_mount"/>
      </joint>

      <xacro:if value="$(arg use_standard_fingertips)">
      <joint name="${prefix}right_finger_tip_joint" type="fixed">
        <origin xyz="0 0 0" rpy="${fingertip_rpy_vis}"/>
        <parent link="${prefix}right_finger_mount"/>
        <child link="${prefix}right_finger_tip_link"/>
      </joint>
      </xacro:if>

      <!-- ================= Left outer proximal finger ================= -->

      <link name="${prefix}left_outer_proximal_finger_link">
        <inertial>
          <origin
            xyz="0.0549431524395895 -0.00249999999999233 0.000300000004998667"
            rpy="0 0 0"/>
          <mass value="0.000949825473476506"/>
          <inertia
            ixx="4.40551301449514E-09"
            ixy="-5.35328244924947E-24"
            ixz="2.43481133533544E-24"
            iyy="4.40551301449513E-09"
            iyz="5.10866980805369E-25"
            izz="6.16606121744734E-09"/>
        </inertial>

        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh
              filename="$(arg mesh_path)/left_outer_proximal_finger_link.STL"/>
          </geometry>
          <material name="${prefix}body_white"/>
        </visual>

        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh
              filename="$(arg mesh_path)/left_outer_proximal_finger_link.STL"/>
          </geometry>
        </collision>
      </link>

      <joint name="${prefix}left_outer_proximal_finger_joint" type="revolute">
        <origin
          xyz="0.0759999999999999 0 0.0170499999950017"
          rpy="1.5707963267949 0 0"/>
        <parent link="${prefix}body_link"/>
        <child link="${prefix}left_outer_proximal_finger_link"/>
        <axis xyz="0 0 1"/>
        <limit
          lower="0"
          upper="${cad_finger_upper}"
          effort="2.9"
          velocity="1.753"/>
        <mimic
          joint="${prefix}finger_joint"
          multiplier="1"
          offset="0"/>
      </joint>

      <!-- ================= Left finger cover arm ================= -->

      <link name="${prefix}left_finger_cover_arm_link">
        <inertial>
          <origin
            xyz="0.00398155371535758 -0.00234551241087921 0.000524978662517488"
            rpy="0 0 0"/>
          <mass value="0.0002753784901893"/>
          <inertia
            ixx="2.52764072470494E-09"
            ixy="1.30270225418703E-09"
            ixz="2.54692664978612E-14"
            iyy="4.02458813479656E-09"
            iyz="-1.18068992924501E-14"
            izz="3.79488588772191E-09"/>
        </inertial>

        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh
              filename="$(arg mesh_path)/left_finger_cover_arm_link.STL"/>
          </geometry>
          <material name="${prefix}cover_grey"/>
        </visual>

        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh
              filename="$(arg mesh_path)/left_finger_cover_arm_link.STL"/>
          </geometry>
        </collision>
      </link>

      <joint name="${prefix}left_finger_cover_arm_joint" type="continuous">
        <origin
          xyz="0.0200247913038149 8.99497540546232E-05 0"
          rpy="0 0 0"/>
        <parent link="${prefix}left_outer_proximal_finger_link"/>
        <child link="${prefix}left_finger_cover_arm_link"/>
        <axis xyz="0 0 1"/>
        <mimic
          joint="${prefix}finger_joint"
          multiplier="-1"
          offset="0"/>
      </joint>

      <!-- ================= Left finger cover ================= -->

      <link name="${prefix}left_finger_cover_link">
        <inertial>
          <origin
            xyz="0.0160456222550394 -0.00117286244301727 0.010813408882006"
            rpy="0 0 0"/>
          <mass value="0.00119298249046695"/>
          <inertia
            ixx="2.1995729016884E-08"
            ixy="1.5479102227688E-08"
            ixz="-1.63237337618954E-09"
            iyy="1.96363375879819E-07"
            iyz="-2.13914442228796E-11"
            izz="2.15524077561246E-07"/>
        </inertial>

        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh
              filename="$(arg mesh_path)/left_finger_cover_link.STL"/>
          </geometry>
          <material name="${prefix}cover_grey"/>
        </visual>

        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh
              filename="$(arg mesh_path)/left_finger_cover_link.STL"/>
          </geometry>
        </collision>
      </link>

      <joint name="${prefix}left_finger_cover_joint" type="continuous">
        <origin
          xyz="0.00825 -0.00475 0"
          rpy="0 0 0"/>
        <parent link="${prefix}left_finger_cover_arm_link"/>
        <child link="${prefix}left_finger_cover_link"/>
        <axis xyz="0 0 1"/>
        <mimic
          joint="${prefix}finger_joint"
          multiplier="1"
          offset="0"/>
      </joint>

      <!-- ================= Left finger base ================= -->

      <link name="${prefix}left_finger_base_link">
        <inertial>
          <origin
            xyz="0.0190391495388169 -0.00734945969008521 0.000299994993758702"
            rpy="0 0 0"/>
          <mass value="0.0113435416196245"/>
          <inertia
            ixx="3.81411331619531E-07"
            ixy="5.77709795343554E-07"
            ixz="1.00938103147903E-13"
            iyy="2.42489387459591E-06"
            iyz="2.12234135747528E-13"
            izz="2.56166646481153E-06"/>
        </inertial>

        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh
              filename="$(arg mesh_path)/left_finger_base_link.STL"/>
          </geometry>
          <material name="${prefix}body_white"/>
        </visual>

        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh
              filename="$(arg mesh_path)/left_finger_base_link.STL"/>
          </geometry>
        </collision>
      </link>

      <joint name="${prefix}left_finger_base_joint" type="continuous">
        <origin
          xyz="0.054943 -0.0025 0"
          rpy="0 0 0"/>
        <parent link="${prefix}left_outer_proximal_finger_link"/>
        <child link="${prefix}left_finger_base_link"/>
        <axis xyz="0 0 1"/>
        <mimic
          joint="${prefix}finger_joint"
          multiplier="-1"
          offset="0"/>
      </joint>

      <!-- ================= Left fingertip ================= -->

      <xacro:if value="$(arg use_standard_fingertips)">
      <link name="${prefix}left_finger_tip_link">
        <xacro:fingertip_inertial/>

        <visual>
          <origin
            xyz="${fingertip_collision_xyz}" 
            rpy="${fingertip_collision_rpy}"/>
          <geometry>
                <mesh filename="${fingertip_mesh}_link.dae"/>
          </geometry>
        </visual>

        <collision>
          <origin
            xyz="${fingertip_collision_xyz}" 
            rpy="${fingertip_collision_rpy}"/>
          <geometry>
                <mesh filename="${fingertip_mesh}_link.STL"/>
          </geometry>
        </collision>
      </link>
      </xacro:if>

      <link name="${prefix}left_finger_mount"/>

      <joint name="${prefix}left_finger_mount_joint" type="fixed">
        <origin
          xyz="0.0365 -0.0145 0.0003"
          rpy="0 0 0"/>
        <parent link="${prefix}left_finger_base_link"/>
        <child link="${prefix}left_finger_mount"/>
      </joint>

      <xacro:if value="$(arg use_standard_fingertips)">
      <joint name="${prefix}left_finger_tip_joint" type="fixed">
        <origin xyz="0 0 0" rpy="${fingertip_rpy_vis}"/>
        <parent link="${prefix}left_finger_mount"/>
        <child link="${prefix}left_finger_tip_link"/>
      </joint>
      </xacro:if>

      <!-- ================= Right inner proximal finger ================= -->

      <link name="${prefix}right_inner_proximal_finger_link">
        <inertial>
          <origin
            xyz="0.0243420753391578 -0.00150984138335663 -1.14846121206326E-10"
            rpy="0 0 0"/>
          <mass value="0.0110525137434334"/>
          <inertia
            ixx="5.28599526468673E-07"
            ixy="1.92388035358472E-07"
            ixz="7.0084725912438E-14"
            iyy="4.58187718349257E-06"
            iyz="-1.5791947291098E-13"
            izz="4.16791084165572E-06"/>
        </inertial>

        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh
              filename="$(arg mesh_path)/right_inner_proximal_finger_link.STL"/>
          </geometry>
          <material name="${prefix}body_white"/>
        </visual>

        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh
              filename="$(arg mesh_path)/right_inner_proximal_finger_link.STL"/>
          </geometry>
        </collision>
      </link>

      <joint name="${prefix}right_inner_proximal_finger_joint" type="continuous">
        <origin
          xyz="0.0925000000000006 0 -0.0074500000049881"
          rpy="-1.57079632679489 0 0"/>
        <parent link="${prefix}body_link"/>
        <child link="${prefix}right_inner_proximal_finger_link"/>
        <axis xyz="0 0 1"/>
        <mimic
          joint="${prefix}finger_joint"
          multiplier="1"
          offset="0"/>
      </joint>

      <!-- ================= Left inner proximal finger ================= -->

      <link name="${prefix}left_inner_proximal_finger_link">
        <inertial>
          <origin
            xyz="0.0243420753391564 -0.00150984138331514 -1.19857137688403E-10"
            rpy="0 0 0"/>
          <mass value="0.0110525137434334"/>
          <inertia
            ixx="5.28599526468524E-07"
            ixy="1.92388035356887E-07"
            ixz="7.00847294261671E-14"
            iyy="4.58187718349272E-06"
            iyz="-1.57919476311131E-13"
            izz="4.16791084165572E-06"/>
        </inertial>

        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh
              filename="$(arg mesh_path)/left_inner_proximal_finger_link.STL"/>
          </geometry>
          <material name="${prefix}body_white"/>
        </visual>

        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh
              filename="$(arg mesh_path)/left_inner_proximal_finger_link.STL"/>
          </geometry>
        </collision>
      </link>

      <joint name="${prefix}left_inner_proximal_finger_joint" type="continuous">
        <origin
          xyz="0.0925 0 0.00754999999500211"
          rpy="1.5707963267949 0 0"/>
        <parent link="${prefix}body_link"/>
        <child link="${prefix}left_inner_proximal_finger_link"/>
        <axis xyz="0 0 1"/>
        <mimic
          joint="${prefix}finger_joint"
          multiplier="1"
          offset="0"/>
      </joint>

      <!-- ================= Fingertip friction ================= -->

      <gazebo reference="${prefix}left_finger_tip_link">
        <mu1>0.4</mu1>
        <mu2>0.4</mu2>
      </gazebo>

      <gazebo reference="${prefix}right_finger_tip_link">
        <mu1>0.4</mu1>
        <mu2>0.4</mu2>
      </gazebo>

      <!-- Semantic aperture joint. The visual finger-angle mapping is intentionally
           not claimed until calibrated; this joint is the ROS command/state API. -->
      <link name="${prefix}grip_stroke_control_link"/>
      <joint name="${prefix}grip_stroke" type="prismatic">
        <parent link="${prefix}base_link"/><child link="${prefix}grip_stroke_control_link"/>
        <axis xyz="1 0 0"/><limit lower="0" upper="0.110" effort="40" velocity="1"/>
      </joint>

    <xacro:if value="${include_ros2_control}">
        <ros2_control name="${prefix}OnRobotRG2System" type="system">
            <hardware>
              <xacro:if value="${backend == 'real'}"><plugin>onrobot_gripper_hardware/OnRobotRgSystem</plugin></xacro:if>
              <xacro:if value="${backend == 'fake'}"><plugin>onrobot_gripper_hardware/OnRobotParallelGripperFakeSystem</plugin></xacro:if>
              <xacro:if value="${backend == 'isaac'}"><plugin>onrobot_gripper_hardware/OnRobotIsaacSystem</plugin></xacro:if>
              <param name="model">rg2</param>
              <param name="transport">${transport}</param>
              <param name="host">${host}</param>
              <param name="port">${port}</param>
              <param name="serial_device">${serial_device}</param>
              <param name="baud_rate">${baud_rate}</param>
              <param name="rtu_parity">${rtu_parity}</param>
              <param name="slave_id">${slave_id}</param>
              <param name="connect_timeout_ms">${connect_timeout_ms}</param>
              <param name="read_timeout_ms">${read_timeout_ms}</param>
              <param name="write_timeout_ms">${write_timeout_ms}</param>
              <param name="safe_width_min_mm">${safe_width_min_mm}</param><param name="safe_width_max_mm">${safe_width_max_mm}</param>
              <param name="default_force_n">${default_force_n}</param>
              <param name="fake_task_min_m">${float(str(safe_width_min_mm)) / 1000.0}</param>
              <param name="fake_task_max_m">${float(str(safe_width_max_mm)) / 1000.0}</param>
              <param name="visual_finger_joint_upper_rad">${cad_finger_upper}</param>
              <!-- Standard CAD rubber surfaces follow the device-compensated
                   aperture; custom fingers continue to use mechanism angle. -->
              <param name="visual_gap_from_aperture">${'true' if '$(arg use_standard_fingertips)' == 'true' and '$(arg fingertip_material)' == 'standard' and '$(arg fingertip_orientation)' == 'inwards' else 'false'}</param>
              <param name="isaac_joint">finger_joint</param>
              <param name="isaac_joint_commands_topic">$(arg isaac_joint_commands_topic)</param>
              <param name="isaac_joint_states_topic">$(arg isaac_joint_states_topic)</param>
              <param name="isaac_state_timeout_ms">$(arg isaac_state_timeout_ms)</param>
              <param name="task_min_m">${float(str(safe_width_min_mm)) / 1000.0}</param>
              <param name="task_max_m">${float(str(safe_width_max_mm)) / 1000.0}</param>
              <param name="physical_min_m">0.0</param>
              <param name="physical_max_m">1.22277767395</param>
              <param name="raw_linear_min_mm">0.0</param>
              <param name="raw_linear_max_mm">1222.77767395</param>
              <param name="realtime_update_rate_hz">${realtime_update_rate_hz}</param>
              <param name="realtime_command_timeout_ms">100</param>
              <param name="realtime_maximum_consecutive_failures">3</param>
            </hardware>
            <joint name="${prefix}grip_stroke">
              <command_interface name="position"/><command_interface name="effort"/>
              <command_interface name="realtime_mode"/>
              <command_interface name="realtime_task_position"/>
              <command_interface name="realtime_mechanism_angular_velocity"/>
              <command_interface name="realtime_force"/>
              <command_interface name="realtime_command_sequence"/>
              <command_interface name="fault_recovery_command_sequence"/>
              <command_interface name="stop_command_sequence"/>
              <command_interface name="conventional_command_sequence"/>
              <state_interface name="position"/><state_interface name="velocity"/>
              <state_interface name="effort"/>
              <state_interface name="task_position_valid"/>
              <state_interface name="force_valid"/><state_interface name="busy"/>
              <state_interface name="grip_detected"/><state_interface name="active_mode"/>
              <state_interface name="safety_status_valid"/>
              <state_interface name="safety_1_pushed"/><state_interface name="safety_1_triggered"/>
              <state_interface name="safety_2_pushed"/><state_interface name="safety_2_triggered"/>
              <state_interface name="safety_dc_error"/>
              <state_interface name="connection_state"/>
              <state_interface name="faulted"/><state_interface name="fault_code"/>
              <state_interface name="firmware_qualification"/>
              <state_interface name="sample_sequence"/><state_interface name="sample_age"/>
              <state_interface name="requested_command_sequence"/>
              <state_interface name="applied_command_sequence"/>
              <state_interface name="successful_cycles"/>
              <state_interface name="failed_cycles"/><state_interface name="missed_deadlines"/>
              <state_interface name="watchdog_stops"/><state_interface name="reconnects"/><state_interface name="last_cycle_duration"/>
              <state_interface name="minimum_task_aperture"/><state_interface name="maximum_task_aperture"/>
              <state_interface name="diagnostic_status_valid"/>
              <state_interface name="diagnostic_identity_valid" />
              <state_interface name="diagnostic_product_code" />
              <state_interface name="diagnostic_firmware_major" />
              <state_interface name="diagnostic_firmware_minor" />
              <state_interface name="diagnostic_firmware_build" />
              <state_interface name="diagnostic_board_revisions_valid" />
              <state_interface name="diagnostic_product_revision" />
              <state_interface name="diagnostic_hardware_revision" />
              <state_interface name="diagnostic_pcb_revision" />
              <state_interface name="diagnostic_firmware_crc_valid" />
              <state_interface name="diagnostic_firmware_crc" />
              <state_interface name="diagnostic_firmware_source_valid" />
              <state_interface name="diagnostic_firmware_git_word_0" />
              <state_interface name="diagnostic_firmware_git_word_1" />
              <state_interface name="diagnostic_firmware_git_word_2" />
              <state_interface name="diagnostic_firmware_git_word_3" />
              <state_interface name="diagnostic_firmware_git_word_4" />
              <state_interface name="diagnostic_raw_status"/>
              <state_interface name="diagnostic_busy"/>
              <state_interface name="diagnostic_grip_detected"/>
              <state_interface name="diagnostic_sample_sequence"/>
              <state_interface name="diagnostic_age"/>
              <state_interface name="diagnostic_command_force"/>
              <state_interface name="diagnostic_command_force_valid"/>
              <state_interface name="diagnostic_measured_force"/>
              <state_interface name="diagnostic_measured_force_valid"/>
              <state_interface name="diagnostic_force_provenance"/>
              <state_interface name="diagnostic_motor_voltage"/>
              <state_interface name="diagnostic_motor_current"/>
              <state_interface name="diagnostic_temperature"/>
              <state_interface name="diagnostic_realtime_linear_velocity"/>
              <state_interface name="diagnostic_realtime_angular_velocity"/>
              <state_interface name="diagnostic_realtime_force"/>
              <state_interface name="diagnostic_supply_power"/>
              <state_interface name="diagnostic_maximum_force"/>
              <state_interface name="diagnostic_maximum_realtime_force"/>
              <state_interface name="diagnostic_statistics_valid"/>
              <state_interface name="diagnostic_conventional_grip_on_time"/>
              <state_interface name="diagnostic_power_cycles"/>
              <state_interface name="diagnostic_conventional_grip_cycles"/>
              <state_interface name="diagnostic_grip_detected_count"/>
              <state_interface name="diagnostic_realtime_grip_on_time"/>
              <state_interface name="diagnostic_rg_fingertip_offset_mm"/>
              <state_interface name="diagnostic_rg_depth_acceleration_mm_s2"/>
              <state_interface name="diagnostic_rg_depth_speed_mm_s"/>
              <state_interface name="diagnostic_rg_actual_depth_mm"/>
              <state_interface name="diagnostic_rg_actual_relative_depth_mm"/>
              <state_interface name="diagnostic_rg_mechanism_angle_rad"/>
              <state_interface name="diagnostic_rg_legacy_angular_velocity_rad_s"/>
              <state_interface name="diagnostic_rg_actual_width_mm"/>
              <state_interface name="diagnostic_rg_voltage_5v_v"/>
              <state_interface name="diagnostic_rg_safety_24v_v"/>
              <state_interface name="diagnostic_rg_plug_24v_v"/>
              <state_interface name="diagnostic_rg_width_with_fingertip_mm"/>
              <state_interface name="diagnostic_rg_error_code"/>
            </joint>
            <joint name="${prefix}finger_joint">
              <state_interface name="position"/><state_interface name="velocity"/>
              <state_interface name="measured_angular_position"/>
              <state_interface name="measured_angular_velocity"/>
              <state_interface name="position_valid"/><state_interface name="velocity_valid"/>
            </joint>
          </ros2_control>
    </xacro:if>
  </xacro:macro>
</robot>
