<?xml version="1.0" encoding="UTF-8"?>

<robot name="onrobot_rg2">

  <!-- Base to body -->

  <disable_collisions
    link1="base_link"
    link2="body_link"
    reason="Adjacent"/>

  <!-- Body to outer proximal fingers -->

  <disable_collisions
    link1="body_link"
    link2="right_outer_proximal_finger_link"
    reason="Adjacent"/>

  <disable_collisions
    link1="body_link"
    link2="left_outer_proximal_finger_link"
    reason="Adjacent"/>

  <!-- Body to inner proximal fingers -->

  <disable_collisions
    link1="body_link"
    link2="right_inner_proximal_finger_link"
    reason="Adjacent"/>

  <disable_collisions
    link1="body_link"
    link2="left_inner_proximal_finger_link"
    reason="Adjacent"/>

  <!-- Inner proximal fingers to finger bases -->

  <disable_collisions
    link1="right_inner_proximal_finger_link"
    link2="right_finger_base_link"
    reason="Adjacent"/>

  <disable_collisions
    link1="left_inner_proximal_finger_link"
    link2="left_finger_base_link"
    reason="Adjacent"/>

  <!-- Outer proximal fingers to finger bases -->

  <disable_collisions
    link1="right_outer_proximal_finger_link"
    link2="right_finger_base_link"
    reason="Adjacent"/>

  <disable_collisions
    link1="left_outer_proximal_finger_link"
    link2="left_finger_base_link"
    reason="Adjacent"/>

  <!-- Finger bases to finger covers -->

  <disable_collisions
    link1="right_finger_base_link"
    link2="right_finger_cover_link"
    reason="Adjacent"/>

  <disable_collisions
    link1="left_finger_base_link"
    link2="left_finger_cover_link"
    reason="Adjacent"/>

  <!-- Finger bases to fingertips -->

  <disable_collisions
    link1="right_finger_base_link"
    link2="right_finger_tip_link"
    reason="Adjacent"/>

  <disable_collisions
    link1="left_finger_base_link"
    link2="left_finger_tip_link"
    reason="Adjacent"/>

</robot>