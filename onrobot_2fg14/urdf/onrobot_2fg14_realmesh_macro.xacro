<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ================= Xacro arguments ================= -->

      <xacro:arg name="mesh_path" default="package://onrobot_2fg14/meshes"/>
      <xacro:arg name="host" default="127.0.0.1"/>
      <xacro:arg name="port" default="502"/>
      <xacro:arg name="transport" default="tcp"/>
      <xacro:arg name="serial_device" default="/dev/ttyUSB0"/>
      <xacro:arg name="baud_rate" default="1000000"/>
      <xacro:arg name="rtu_parity" default="even"/>
      <xacro:arg name="slave_id" default="65"/>
      <xacro:arg name="connect_timeout_ms" default="1000"/>
      <xacro:arg name="read_timeout_ms" default="1000"/>
      <xacro:arg name="write_timeout_ms" default="1000"/>
      <xacro:arg name="backend" default="real"/>
      <xacro:arg name="isaac_joint_commands_topic" default="isaac_joint_commands"/>
      <xacro:arg name="isaac_joint_states_topic" default="isaac_joint_states"/>
      <xacro:arg name="isaac_state_timeout_ms" default="250"/>
      <xacro:arg name="realtime_update_rate_hz" default="50"/>
      <xacro:arg name="supply_power_w" default="48"/>
      <xacro:arg name="conventional_speed_percent" default="50"/>
      <xacro:arg name="include_task_coordinate" default="true"/>
      <xacro:arg name="include_ros2_control" default="true"/>

      <!-- outwards or inwards -->
      <xacro:arg name="fingertip_orientation" default="outwards"/>
      <xacro:arg name="use_standard_fingertips" default="true"/>

      <!-- Stroke/limits -->
      <xacro:arg name="finger_stroke" default="0.025"/>
      <xacro:arg name="task_aperture" default="0.140"/>
      <xacro:arg name="finger_effort" default="280"/>
      <xacro:arg name="finger_velocity" default="0.45"/>

  <xacro:macro name="onrobot_2fg14_realmesh"
               params="parent:='' prefix:='' origin_xyz:='0 0 0' origin_rpy:='0 0 0' backend:='real' host:='127.0.0.1' port:='502' transport:='tcp' serial_device:='/dev/ttyUSB0' baud_rate:='1000000' rtu_parity:='even' slave_id:='65' connect_timeout_ms:='1000' read_timeout_ms:='1000' write_timeout_ms:='1000' include_task_coordinate:=true include_ros2_control:=true">
    <xacro:if value="${parent != ''}">
      <joint name="${prefix}mount_joint" type="fixed">
        <parent link="${parent}"/>
        <child link="${prefix}base_link"/>
        <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
      </joint>
    </xacro:if>
      <!-- Constants -->
      <xacro:property name="x_pi" value="3.14159265359"/>
      <xacro:property name="x_half_pi" value="1.57079632679"/>

      <!-- NBR fingertip friction -->
      <xacro:property name="fingertip_mu" value="0.4"/>

      <!-- ================= Fingertip orientation ================= -->

      <xacro:if value="${'$(arg fingertip_orientation)' == 'outwards'}">
        <xacro:property name="fingertip_roll_vis" value="-${x_half_pi}"/>    
        <xacro:property name="fingertip_pitch_vis" value="0"/>
        <xacro:property name="fingertip_yaw_vis" value="0"/>

        <xacro:property name="fingertip_roll_col" value="0"/>    
        <xacro:property name="fingertip_pitch_col" value="0"/>
        <xacro:property name="fingertip_yaw_col" value="0"/>
      </xacro:if>

      <xacro:unless value="${'$(arg fingertip_orientation)' == 'outwards'}">
        <xacro:property name="fingertip_roll_vis" value="${x_half_pi}"/>    
        <xacro:property name="fingertip_pitch_vis" value="0"/>
        <xacro:property name="fingertip_yaw_vis" value="0"/>

        <xacro:property name="fingertip_roll_col" value="${x_pi}"/>    
        <xacro:property name="fingertip_pitch_col" value="0"/>
        <xacro:property name="fingertip_yaw_col" value="0"/>
      </xacro:unless>

      <!-- ================= Base link ================= -->

      <link name="${prefix}base_link">
        <inertial>
          <origin
            xyz="-0.00015729 3.543E-05 0.069388"
            rpy="0 0 0" />
          <mass value="1.4087" />
          <inertia
            ixx="0.0011866"
            ixy="-1.0464E-07"
            ixz="3.7576E-07"
            iyy="0.0019997"
            iyz="-2.7094E-07"
            izz="0.0019805" />
        </inertial>

        <visual>
          <origin
            xyz="0 0 0.0138"
            rpy="0 3.14159265359 1.57079632679" />
          <geometry>
            <mesh filename="$(arg mesh_path)/base_link.dae" />
          </geometry>
        </visual>

        <collision>
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="$(arg mesh_path)/base_link.STL" />
          </geometry>
        </collision>
      </link>

      <!-- ================= Task aperture coordinate ================= -->

      <xacro:if value="${include_task_coordinate}">
        <link name="${prefix}task_aperture_link"/>
        <joint name="${prefix}grip_stroke" type="prismatic">
          <parent link="${prefix}base_link" />
          <child link="${prefix}task_aperture_link" />
          <axis xyz="1 0 0" />
          <limit lower="0" upper="$(arg task_aperture)" effort="$(arg finger_effort)" velocity="$(arg finger_velocity)" />
        </joint>
      </xacro:if>

      <!-- ================= Right finger base ================= -->

      <link name="${prefix}right_finger_base_link">
        <inertial>
          <origin
            xyz="-0.006 -2.6252E-17 -1.5092E-15"
            rpy="0 0 0" />
          <mass value="0.014039" />
          <inertia
            ixx="4.5646E-07"
            ixy="-5.1808E-22"
            ixz="-1.0037E-19"
            iyy="5.775E-07"
            iyz="3.7117E-20"
            izz="2.1589E-07" />
        </inertial>

        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="$(arg mesh_path)/finger_base_link.STL" />
          </geometry>
          <material name="">
            <color rgba="0.75294 0.75294 0.75294 1" />
          </material>
        </visual>

        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="$(arg mesh_path)/finger_base_link.STL" />
          </geometry>
        </collision>
      </link>

      <joint name="${prefix}finger_stroke" type="prismatic">
        <origin
          xyz="0.017995 0 0.117"
          rpy="3.1416 -1.5708 0" />
        <parent link="${prefix}base_link" />
        <child link="${prefix}right_finger_base_link" />
        <axis xyz="0 0 1" />
        <limit
          lower="0"
          upper="$(arg finger_stroke)"
          effort="$(arg finger_effort)"
          velocity="$(arg finger_velocity)" />
      </joint>

      <!-- ================= Right fingertip ================= -->

      <xacro:if value="$(arg use_standard_fingertips)">
      <link name="${prefix}right_fingertip_link">
        <inertial>
          <origin
            xyz="0.01595 -2.6319E-06 0.0073333"
            rpy="${x_pi} 0 0" />
          <mass value="0.053363" />
          <inertia
            ixx="9.7475E-06"
            ixy="4.1758E-12"
            ixz="-2.5801E-06"
            iyy="1.347E-05"
            iyz="2.4036E-11"
            izz="1.8961E-05" />
        </inertial>

        <visual>
          <origin
            xyz="0 0 0"
            rpy="${fingertip_roll_vis} ${fingertip_pitch_vis} ${fingertip_yaw_vis}" />
          <geometry>
            <mesh filename="$(arg mesh_path)/fingertip_link.dae" />
          </geometry>
        </visual>

        <collision>
          <origin
            xyz="0 0 0"
            rpy="${fingertip_roll_col} ${fingertip_pitch_col} ${fingertip_yaw_col}" />
          <geometry>
            <mesh filename="$(arg mesh_path)/fingertip_link.STL" />
          </geometry>
        </collision>
      </link>
      </xacro:if>

      <link name="${prefix}right_finger_mount" />

      <joint name="${prefix}right_finger_mount_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="${prefix}right_finger_base_link" />
        <child link="${prefix}right_finger_mount" />
      </joint>

      <xacro:if value="$(arg use_standard_fingertips)">
      <joint name="${prefix}right_fingertip_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="${prefix}right_finger_mount" />
        <child link="${prefix}right_fingertip_link" />
      </joint>
      </xacro:if>

      <!-- ================= Left finger base ================= -->

      <link name="${prefix}left_finger_base_link">
        <inertial>
          <origin
            xyz="-0.006 -1.3226E-17 1.5127E-15"
            rpy="0 0 0" />
          <mass value="0.014039" />
          <inertia
            ixx="4.5646E-07"
            ixy="-3.4132E-22"
            ixz="1.0034E-19"
            iyy="5.775E-07"
            iyz="3.4587E-20"
            izz="2.1589E-07" />
        </inertial>

        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="$(arg mesh_path)/finger_base_link.STL" />
          </geometry>
          <material name="">
            <color rgba="0.75294 0.75294 0.75294 1" />
          </material>
        </visual>

        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="$(arg mesh_path)/finger_base_link.STL" />
          </geometry>
        </collision>
      </link>

      <joint name="${prefix}left_finger_base_joint" type="prismatic">
        <origin
          xyz="-0.017995 0 0.117"
          rpy="0 -1.5708 0" />
        <parent link="${prefix}base_link" />
        <child link="${prefix}left_finger_base_link" />
        <axis xyz="0 0 1" />
        <limit
          lower="0"
          upper="$(arg finger_stroke)"
          effort="$(arg finger_effort)"
          velocity="$(arg finger_velocity)" />
        <mimic
          joint="${prefix}finger_stroke"
          multiplier="1.0"
          offset="0" />
      </joint>

      <!-- ================= Left fingertip ================= -->

      <xacro:if value="$(arg use_standard_fingertips)">
      <link name="${prefix}left_fingertip_link">
        <inertial>
          <origin
            xyz="0.015961 -2.5916E-08 0.0073333"
            rpy="${x_pi} 0 0" />
          <mass value="0.053363" />
          <inertia
            ixx="9.7475E-06"
            ixy="4.1758E-12"
            ixz="-2.5801E-06"
            iyy="1.347E-05"
            iyz="2.4036E-11"
            izz="1.8961E-05" />
        </inertial>

        <visual>
          <origin
            xyz="0 0 0"
            rpy="${fingertip_roll_vis} ${fingertip_pitch_vis} ${fingertip_yaw_vis}" />
          <geometry>
            <mesh filename="$(arg mesh_path)/fingertip_link.dae" />
          </geometry>
        </visual>

        <collision>
          <origin
            xyz="0 0 0"
            rpy="${fingertip_roll_col} ${fingertip_pitch_col} ${fingertip_yaw_col}" />
          <geometry>
            <mesh filename="$(arg mesh_path)/fingertip_link.STL" />
          </geometry>
        </collision>
      </link>
      </xacro:if>

      <link name="${prefix}left_finger_mount" />

      <joint name="${prefix}left_finger_mount_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="${prefix}left_finger_base_link" />
        <child link="${prefix}left_finger_mount" />
      </joint>

      <xacro:if value="$(arg use_standard_fingertips)">
      <joint name="${prefix}left_fingertip_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="${prefix}left_finger_mount" />
        <child link="${prefix}left_fingertip_link" />
      </joint>
      </xacro:if>

      <xacro:if value="$(arg use_standard_fingertips)">
      <gazebo reference="${prefix}right_fingertip_link">
        <mu1>${fingertip_mu}</mu1>
        <mu2>${fingertip_mu}</mu2>
      </gazebo>

      <gazebo reference="${prefix}left_fingertip_link">
        <mu1>${fingertip_mu}</mu1>
        <mu2>${fingertip_mu}</mu2>
      </gazebo>
      </xacro:if>

      <!-- Standard and realtime controllers claim this one ros2_control hardware
           contract mutually exclusively. -->

    <xacro:if value="${include_ros2_control}">
        <ros2_control name="${prefix}OnRobot2FG14System" type="system">
            <hardware>
              <xacro:if value="${backend == 'real'}">
                <plugin>onrobot_gripper_hardware/OnRobotGripperSystem</plugin>
              </xacro:if>
              <xacro:if value="${backend == 'fake'}">
                <plugin>onrobot_gripper_hardware/OnRobotParallelGripperFakeSystem</plugin>
              </xacro:if>
              <xacro:if value="${backend == 'isaac'}">
                <plugin>onrobot_gripper_hardware/OnRobotIsaacSystem</plugin>
              </xacro:if>
              <param name="model">2fg14</param>
              <param name="transport">${transport}</param>
              <param name="host">${host}</param>
              <param name="port">${port}</param>
              <param name="serial_device">${serial_device}</param>
              <param name="baud_rate">${baud_rate}</param>
              <param name="rtu_parity">${rtu_parity}</param>
              <param name="slave_id">${slave_id}</param>
              <param name="connect_timeout_ms">${connect_timeout_ms}</param>
              <param name="read_timeout_ms">${read_timeout_ms}</param>
              <param name="write_timeout_ms">${write_timeout_ms}</param>
              <param name="finger_joint_upper_m">0.025</param>
              <param name="raw_linear_min_mm">1.0</param>
              <param name="raw_linear_max_mm">51.0</param>
              <param name="task_min_m">0.0</param>
              <param name="task_max_m">$(arg task_aperture)</param>
              <param name="physical_min_m">0.0</param>
              <param name="physical_max_m">0.025</param>
              <param name="isaac_joint">finger_stroke</param>
              <param name="isaac_joint_commands_topic">$(arg isaac_joint_commands_topic)</param>
              <param name="isaac_joint_states_topic">$(arg isaac_joint_states_topic)</param>
              <param name="isaac_state_timeout_ms">$(arg isaac_state_timeout_ms)</param>
              <param name="fake_task_min_m">0.0</param>
              <param name="fake_task_max_m">$(arg task_aperture)</param>
              <param name="default_force_n">40.0</param>
              <param name="supply_power_w">$(arg supply_power_w)</param>
              <param name="speed_percent">$(arg conventional_speed_percent)</param>
              <param name="poll_period_ms">20</param>
              <param name="realtime_update_rate_hz">$(arg realtime_update_rate_hz)</param>
              <param name="realtime_command_timeout_ms">100</param>
              <param name="realtime_maximum_consecutive_failures">3</param>
            </hardware>
            <joint name="${prefix}grip_stroke">
              <command_interface name="position" />
              <command_interface name="effort" />
              <command_interface name="realtime_mode" />
              <command_interface name="realtime_task_position" />
              <command_interface name="realtime_task_velocity" />
              <command_interface name="realtime_force" />
              <command_interface name="realtime_command_sequence" />
              <command_interface name="fault_recovery_command_sequence" />
              <command_interface name="stop_command_sequence" />
              <command_interface name="conventional_command_sequence" />
              <!-- Isaac receives target position/effort only. It has no verified
                   percentage-to-motion mapping, so do not advertise a speed command. -->
              <xacro:if value="${backend != 'isaac'}">
                <command_interface name="conventional_speed_percent" />
              </xacro:if>
              <state_interface name="position" />
              <state_interface name="velocity" />
              <state_interface name="effort" />
              <state_interface name="task_position_valid" />
              <state_interface name="force_valid" />
              <state_interface name="busy" />
              <state_interface name="grip_detected" />
              <state_interface name="active_mode" />
              <state_interface name="connection_state" />
              <state_interface name="faulted" />
              <state_interface name="fault_code" />
              <state_interface name="firmware_qualification" />
              <state_interface name="realtime_force_control_available" />
              <state_interface name="sample_sequence" />
              <state_interface name="sample_age" />
              <state_interface name="requested_command_sequence" />
              <state_interface name="applied_command_sequence" />
              <state_interface name="successful_cycles" />
              <state_interface name="failed_cycles" />
              <state_interface name="missed_deadlines" />
              <state_interface name="watchdog_stops" />
              <state_interface name="reconnects" />
              <state_interface name="last_cycle_duration" />
              <state_interface name="minimum_task_aperture" />
              <state_interface name="maximum_task_aperture" />
              <state_interface name="diagnostic_status_valid" />
              <state_interface name="diagnostic_identity_valid" />
              <state_interface name="diagnostic_product_code" />
              <state_interface name="diagnostic_firmware_major" />
              <state_interface name="diagnostic_firmware_minor" />
              <state_interface name="diagnostic_firmware_build" />
              <state_interface name="diagnostic_board_revisions_valid" />
              <state_interface name="diagnostic_product_revision" />
              <state_interface name="diagnostic_hardware_revision" />
              <state_interface name="diagnostic_pcb_revision" />
              <state_interface name="diagnostic_firmware_crc_valid" />
              <state_interface name="diagnostic_firmware_crc" />
              <state_interface name="diagnostic_firmware_source_valid" />
              <state_interface name="diagnostic_firmware_git_word_0" />
              <state_interface name="diagnostic_firmware_git_word_1" />
              <state_interface name="diagnostic_firmware_git_word_2" />
              <state_interface name="diagnostic_firmware_git_word_3" />
              <state_interface name="diagnostic_firmware_git_word_4" />
              <state_interface name="diagnostic_raw_status" />
              <state_interface name="diagnostic_busy" />
              <state_interface name="diagnostic_grip_detected" />
              <state_interface name="diagnostic_sample_sequence" />
              <state_interface name="diagnostic_age" />
              <state_interface name="diagnostic_command_force" />
              <state_interface name="diagnostic_command_force_valid" />
              <state_interface name="diagnostic_measured_force" />
              <state_interface name="diagnostic_measured_force_valid" />
              <state_interface name="diagnostic_force_provenance" />
              <state_interface name="diagnostic_motor_voltage" />
              <state_interface name="diagnostic_motor_current" />
              <state_interface name="diagnostic_temperature" />
              <state_interface name="diagnostic_realtime_linear_velocity" />
              <state_interface name="diagnostic_realtime_angular_velocity" />
              <state_interface name="diagnostic_realtime_force" />
              <state_interface name="diagnostic_supply_power" />
              <state_interface name="diagnostic_maximum_force" />
              <state_interface name="diagnostic_maximum_realtime_force" />
              <state_interface name="diagnostic_statistics_valid" />
              <state_interface name="diagnostic_conventional_grip_on_time" />
              <state_interface name="diagnostic_power_cycles" />
              <state_interface name="diagnostic_conventional_grip_cycles" />
              <state_interface name="diagnostic_grip_detected_count" />
              <state_interface name="diagnostic_realtime_grip_on_time" />
              <state_interface name="diagnostic_not_calibrated" />
              <state_interface name="diagnostic_linear_sensor_error" />
              <state_interface name="diagnostic_external_width_mm" />
              <state_interface name="diagnostic_internal_width_mm" />
              <state_interface name="diagnostic_minimum_external_width_mm" />
              <state_interface name="diagnostic_maximum_external_width_mm" />
              <state_interface name="diagnostic_minimum_internal_width_mm" />
              <state_interface name="diagnostic_maximum_internal_width_mm" />
              <state_interface name="diagnostic_additional_results_raw" />
              <state_interface name="diagnostic_linear_mechanism_position_mm" />
              <state_interface name="diagnostic_raw_motor_width_mm" />
              <state_interface name="diagnostic_voltage_5v_v" />
              <state_interface name="diagnostic_linear_count" />
              <state_interface name="diagnostic_motor_speed_rpm" />
              <state_interface name="diagnostic_angle_sensor_count" />
              <state_interface name="diagnostic_linear_error_count" />
              <state_interface name="diagnostic_realtime_external_width_mm" />
            </joint>
            <joint name="${prefix}finger_stroke">
              <state_interface name="position" />
              <state_interface name="velocity" />
              <state_interface name="measured_position" />
              <state_interface name="measured_velocity" />
              <state_interface name="position_valid" />
              <state_interface name="velocity_valid" />
            </joint>
          </ros2_control>
    </xacro:if>
  </xacro:macro>
</robot>
